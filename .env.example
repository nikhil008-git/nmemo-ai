# Copy this file to .env for the API and root-level tooling. Do not commit real values.

# App URLs
PORT=8080
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
OAUTH_REDIRECT_BASE=http://localhost:8080

# Authentication and encryption — use long, unique random values outside local development.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-second-long-random-secret

# Optional Google sign-in. Callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Persistence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nmemo
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Model providers
VOYAGE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional OAuth connectors. Configure callback URLs as documented in apps/api/README.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Optional operational tuning
CONTEXT_TOKEN_BUDGET=6000
RATE_LIMIT_CONTEXT_MAX=60
RATE_LIMIT_INGEST_MAX=20
RATE_LIMIT_API_MAX=300

# Optional waitlist email sender — used by `npm run waitlist:send -w api`.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="nmemo <hello@example.com>"
