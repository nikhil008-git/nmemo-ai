DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (user sign-in) — callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypt connector tokens at rest (falls back to BETTER_AUTH_SECRET in dev).
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Frontend → API
NEXT_PUBLIC_API_URL=http://localhost:8080
# Public site URL (SEO, Open Graph, canonical)
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
OAUTH_REDIRECT_BASE=http://localhost:8080
# Comma-separated allowlist for browser CORS (production: your real origins)
CORS_ORIGINS=http://localhost:3000
PORT=8080
NODE_ENV=development

# Rate limits (per API key or IP, per minute)
RATE_LIMIT_CONTEXT_MAX=60
RATE_LIMIT_INGEST_MAX=20
RATE_LIMIT_API_MAX=300
# Soft cap for assembled prompt context
CONTEXT_TOKEN_BUDGET=6000

# OAuth apps — optional PLATFORM / OPERATOR one-click Connect.
# Users can also paste tokens on /connectors (recommended to go live without these):
#   GitHub PAT (ghp_…) · Slack USER token (xoxp- + search:read; bot xoxb- will fail) · Notion internal integration secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# RAG
VOYAGE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Waitlist mail (Nodemailer) — npm run waitlist:send -w api
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="nmemo <hello@nmemo.app>"
# WAITLIST_CSV=../../waitlist.csv
# FRONTEND_URL=https://your-domain.com
