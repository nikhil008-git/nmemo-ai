{
  "name": "nmemo-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "nmemo Context Engine SDK — getContext across memory, docs, and connectors",
  "license": "MIT",
  "author": "nmemo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikhil008-git/nmemo-ai.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://nmemo.cloud",
  "keywords": [
    "context-engine",
