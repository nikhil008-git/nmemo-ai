{
  "name": "@contextengine/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Context Engine SDK — getContext across memory, docs, and connectors",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@contextengine/retriever-interface": "*"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "typescript": "5.9.2"
  }
}
