    "./retrieval": {
      "types": "./dist/retrieval.d.ts",
      "default": "./dist/retrieval.js"
    }
  },
  "dependencies": {
    "@repo/shared": "*"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "typescript": "5.9.2"
  }
