{
  "name": "api",
  "version": "0.1.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @repo/db -w @contextengine/retriever-interface -w @contextengine/rag-retriever -w @contextengine/core && tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "waitlist:send": "tsx src/mail/send-waitlist.ts"
  },
  "keywords": ["nmemo", "context-engine", "rag", "ai-agents"],
  "license": "MIT",
  "description": "nmemo's Express API for context retrieval and workspace management.",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.16",
    "@contextengine/core": "*",
    "@contextengine/rag-retriever": "*",
    "@repo/db": "*",
    "@types/express": "^5.0.6",
    "ai": "^7.0.31",
    "better-auth": "^1.5.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.1"
  }
}
